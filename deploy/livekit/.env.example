# Copy to .env. Compose interpolates these into docker-compose.yml.
#
# The values here are NOT the Carevelo API's environment -- that is
# backend/.env, and it needs LIVEKIT_API_KEY, LIVEKIT_API_SECRET and LIVEKIT_URL.
# See README.md.

# The one hostname this deployment answers on. It is the signalling endpoint
# (wss://MEDIA_DOMAIN), the TURN realm, and the name on the certificate -- one
# name means one certificate and one renewal to forget about.
MEDIA_DOMAIN=media.example.ug

# Where Let's Encrypt sends expiry warnings. Set it to a mailbox somebody reads.
ACME_EMAIL=ops@example.ug

# This server's public IPv4 address, literally.
#
# It is used twice and both matter: coturn advertises it to clients, and coturn
# refuses to relay to anything else. That second use is what keeps a leaked TURN
# password from turning this box into somebody's free proxy on our bandwidth.
MEDIA_PUBLIC_IP=203.0.113.10

# The TURN long-term credential's password, for the user `carevelo`.
#
# Handed to every browser as an ICE server, so it is not secret from users. It
# must match `credential:` under rtc.turn_servers in livekit.yaml. Generate with:
#   openssl rand -hex 24
TURN_PASSWORD=replace-me
