# LiveKit SFU -- production configuration template.
#
# Copy to livekit.yaml (gitignored, because the file below carries two secrets)
# and fill in the four marked values. README.md walks through generating them.
#
# NOTHING HERE ENABLES EGRESS, AND NOTHING MAY. Consultation recording is a
# standing non-goal in four documents, and ADR-0004's residency argument rests on
# there being no store of consultation media to breach -- only ephemeral streams.
# Egress is the LiveKit component that would create such a store. It ships in the
# same Apache-2.0 distribution we already run, which makes self-hosting the moment
# it becomes tempting: it is one more service in the compose file and it costs
# nothing to switch on. There is no egress service in docker-compose.yml, no
# `roomRecord` in the grant Carevelo mints, and this comment is the third place
# it is refused.

# The signalling / API port. Bound on the host, and closed to the world by the
# firewall: Caddy terminates TLS on 443 and proxies here over loopback.
port: 7880

# THE KEY PAIR. `key: secret`, and the secret must be at least 32 characters --
# LiveKit refuses to start otherwise, outside --dev.
#
# Generate with:  docker run --rm livekit/livekit-server generate-keys
#
# The same pair goes into the Carevelo API's environment as LIVEKIT_API_KEY and
# LIVEKIT_API_SECRET. Anyone holding the secret can mint a token for any room,
# and a room name is `apt-{ulid}` where the ulid appears in our own API
# responses -- so this value is a key to any named patient's consultation. Treat
# it exactly as config/video.php says: never logged, never in a response, never
# in an exception message.
keys:
  REPLACE_WITH_API_KEY: REPLACE_WITH_API_SECRET_AT_LEAST_32_CHARS

rtc:
  # WebRTC media over UDP, on ONE port rather than a range. A single multiplexed
  # port is a single firewall rule and a single thing to check when media does
  # not flow; a 10,000-port range is a much larger hole and much harder to reason
  # about at 9am.
  udp_port: 7882

  # The TCP fallback, for networks that drop UDP entirely. It is not a substitute
  # for TURN -- it helps a client that can reach us but not over UDP, and does
  # nothing for a client behind CGNAT that cannot be reached at all.
  tcp_port: 7881

  # Discover and advertise the public address. Without it the SFU advertises the
  # address it sees on its own interface, which on a cloud provider using 1:1 NAT
  # is a private address no patient can reach: the call negotiates and then
  # connects to nothing.
  use_external_ip: true

  # THE RELAY, HANDED TO EVERY CLIENT AS AN ICE SERVER.
  #
  # This is the single most important block in the file for Uganda. Mobile
  # carriers here put subscribers behind carrier-grade NAT, so for a large share
  # of patients there is no address the SFU can send to and no hole they can
  # open. Their media has to be relayed, and this is what tells their browser
  # where to relay it.
  #
  # Host, username and credential must match coturn's --realm and --user in
  # docker-compose.yml. They are handed to browsers, so they are not secret from
  # users; what stops the internet relaying through us is coturn's
  # allowed-peer-ip, which permits exactly one destination -- this server.
  turn_servers:
    - host: REPLACE_WITH_MEDIA_DOMAIN
      port: 5349
      protocol: tls
      username: carevelo
      credential: REPLACE_WITH_TURN_PASSWORD

# Rooms are created by the first participant to arrive holding a token that names
# one, and destroyed shortly after the last one leaves. Carevelo never calls the
# room API, so this is the whole room lifecycle.
room:
  # A consultation with nobody in it is over. Two minutes is enough to survive a
  # patient's tunnel or a dropped 3G connection without leaving empty rooms
  # holding resources.
  empty_timeout: 120

  # Two participants. There is no observer seat in a consultation, and a cap is
  # the cheapest guard against a leaked join credential turning a room into a
  # meeting.
  max_participants: 2

logging:
  level: info

  # NOT json, and not debug. These logs sit on a VPS outside the tenant database
  # and outside row-level security, they are read by whoever is debugging a call
  # that morning, and they carry room names and participant identities. Room
  # names are opaque and identities are the strings 'patient' and 'clinician' --
  # which is exactly why the token grant is kept that narrow, and why raising
  # this to debug (which logs far more of each session) deserves a moment's
  # thought rather than a reflex.
  json: false
