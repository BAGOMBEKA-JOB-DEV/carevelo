# Container environment for the API, worker, scheduler and Reverb.
#
# DEVELOPMENT VALUES ONLY. Every secret here is in the repository and therefore
# public. A production stack takes these from a secret store.
#
# The two database roles are the tenant-isolation control: carevelo_migrator owns
# the schema, carevelo_app owns nothing and holds NOBYPASSRLS, because PostgreSQL
# exempts a table's owner from row-level security. Both are created by
# `php artisan db:roles`, which the `setup` service runs.
APP_NAME=Carevelo
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# A FIXED DEVELOPMENT KEY, AND THE CONTAINER MUST NEVER GENERATE ONE.
#
# `setup` used to run `php artisan key:generate --force`. ./backend is mounted,
# so that wrote to the DEVELOPER'S OWN .env -- it replaced a working key with a
# malformed one and broke 76 local tests with "Unsupported cipher or incorrect
# key length", because every encrypted column became unreadable.
#
# Laravel reads container environment ahead of .env, so setting it here is
# enough and nothing on the host is touched. A fixed key is also the right
# behaviour rather than a compromise: one regenerated per `docker compose up`
# would make every encrypted value written by the previous run undecryptable.
#
# Development only. It is in the repository and therefore public.
APP_KEY=base64:kZQ9uH3vRt8mWx2pLcN6yF1sJd4gTbA7eVnO5iXrQmU=

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=carevelo
DB_USERNAME=carevelo_app
DB_PASSWORD=app_secret
DB_MIGRATOR_USERNAME=carevelo_migrator
DB_MIGRATOR_PASSWORD=migrator_secret

# NOT read by anything. db:roles takes its superuser from --superuser and
# --superuser-password on the command line, which is where the compose passes
# them; the command's own error message says "set DB_SUPERUSER_PASSWORD" and is
# wrong about that. Kept here only so nobody adds them back thinking they work.
# DB_SUPERUSER_USERNAME=postgres
# DB_SUPERUSER_PASSWORD=postgres

# ---------------------------------------------------------------------------
# THE SESSION BLOCK TRACKS backend/.env EXACTLY. DO NOT "IMPROVE" IT.
#
# I once set SESSION_DRIVER=redis here on the assumption that a Laravel stack
# ought to use Redis, without reading the working file beside it. This app uses
# COOKIE sessions: the whole session travels in the cookie the portal re-issues
# on its own response (patient-portal domains/identity/api/session.ts). With the
# redis driver only an ID is in that cookie and the API cannot find the session
# behind it, so every authenticated request is a 401 and every screen says "your
# session has ended" the moment after a successful sign-in.
#
# Nothing goes red when this is wrong. Sign-in succeeds; it is the NEXT request
# that fails. That is why it must mirror rather than diverge.
# ---------------------------------------------------------------------------
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ---------------------------------------------------------------------------
# THESE TWO DIVERGE FROM backend/.env DELIBERATELY, because a container stack is
# not a laptop. Local uses CACHE_STORE=array and QUEUE_CONNECTION=sync, and both
# are wrong across containers:
#
#   array  -- four app containers and a worker would each hold a PRIVATE cache,
#             which is not what a shared cache means.
#   sync   -- runs jobs inline, so the `worker` service would sit there doing
#             nothing while looking perfectly healthy.
#
# Redis is here to serve those two and nothing else. The session above must not
# be moved onto it.
# ---------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
QUEUE_CONNECTION=redis
CACHE_STORE=redis

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=carevelo-local
REVERB_APP_KEY=carevelo-local-key
REVERB_APP_SECRET=carevelo-local-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# Self-hosted LiveKit, dev mode. These are LiveKit's published development
# credentials and are safe ONLY because `--dev` accepts nothing else; a real
# deployment generates its own. See deploy/livekit/README.md.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
