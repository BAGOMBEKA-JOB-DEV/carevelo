# Container environment for the API, worker, scheduler and Reverb.
#
# DEVELOPMENT VALUES ONLY. Every secret here is in the repository and therefore
# public. A production stack takes these from a secret store.
#
# The two database roles are the tenant-isolation control: carevelo_migrator owns
# the schema, carevelo_app owns nothing and holds NOBYPASSRLS, because PostgreSQL
# exempts a table's owner from row-level security. Both are created by
# `php artisan db:roles`, which the `setup` service runs.
APP_NAME=Carevelo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=carevelo
DB_USERNAME=carevelo_app
DB_PASSWORD=app_secret
DB_MIGRATOR_USERNAME=carevelo_migrator
DB_MIGRATOR_PASSWORD=migrator_secret

# The superuser db:roles connects as to create the two roles above.
DB_SUPERUSER_USERNAME=postgres
DB_SUPERUSER_PASSWORD=postgres

REDIS_HOST=redis
REDIS_PORT=6379
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=carevelo-local
REVERB_APP_KEY=carevelo-local-key
REVERB_APP_SECRET=carevelo-local-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# Self-hosted LiveKit, dev mode. These are LiveKit's published development
# credentials and are safe ONLY because `--dev` accepts nothing else; a real
# deployment generates its own. See deploy/livekit/README.md.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
