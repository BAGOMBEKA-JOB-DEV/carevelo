# Where the Carevelo API lives.
#
# Next reads .env files from the APP directory, not the workspace root — a root-level
# file is silently ignored, which shows up as the portal falling back to https:// and
# failing with ERR_SSL_WRONG_VERSION_NUMBER against a plain-HTTP dev server.
#
# The app keeps the CLINIC's subdomain and swaps in this origin, so a request to
# kira.localhost:3000 reaches kira.localhost:8000. Tenancy is resolved from the host and
# never from a client-supplied value, so the subdomain has to survive the swap.
#
# In production the API and the apps share a host and this is left unset.
NEXT_PUBLIC_API_ORIGIN=http://localhost:8000
