{
  "name": "carevelo-frontend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "budget": "node scripts/bundle-budget.mjs",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "boundaries": "pnpm -r boundaries && NODE_OPTIONS=--max-old-space-size=8192 depcruise apps --config .dependency-cruiser.cross-app.cjs --ts-config tsconfig.base.json",
    "boundaries:graph": "depcruise apps packages --config .dependency-cruiser.cross-app.cjs --ts-config tsconfig.base.json --output-type dot > boundaries.dot",
    "api-client:generate": "pnpm --filter @carevelo/api-client generate",
    "api-client:check": "pnpm --filter @carevelo/api-client check",
    "check": "pnpm typecheck && pnpm lint && pnpm boundaries && pnpm api-client:check && pnpm test && pnpm build",
    "test": "./packages/ui/node_modules/.bin/vitest run",
    "test:watch": "./packages/ui/node_modules/.bin/vitest",
    "test:e2e": "playwright test",
    "test:visual": "playwright test e2e/visual.spec.ts",
    "dev": "pnpm --filter @carevelo/patient-portal dev --hostname 0.0.0.0",
    "dev:console": "pnpm --filter @carevelo/clinic-console dev --hostname 0.0.0.0",
    "dev:rider": "pnpm --filter @carevelo/rider-view dev --hostname 0.0.0.0",
    "dev:admin": "pnpm --filter @carevelo/platform-admin dev --hostname 0.0.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "16.3.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@vitejs/plugin-react": "^5.2.0",
    "dependency-cruiser": "18.2.0",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.11.0",
    "jsdom": "^27.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0"
  }
}
