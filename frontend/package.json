{
  "name": "carevelo-frontend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "boundaries": "depcruise apps packages --config .dependency-cruiser.cjs",
    "boundaries:graph": "depcruise apps packages --config .dependency-cruiser.cjs --output-type dot > boundaries.dot",
    "api-client:generate": "pnpm --filter @carevelo/api-client generate",
    "api-client:check": "pnpm --filter @carevelo/api-client check",
    "check": "pnpm typecheck && pnpm lint && pnpm boundaries && pnpm api-client:check && pnpm test && pnpm build",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "dependency-cruiser": "18.2.0",
    "eslint": "10.8.1",
    "eslint-plugin-boundaries": "7.2.0",
    "typescript": "5.9.3"
  }
}
