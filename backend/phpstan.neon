includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app
        - database
        - routes
        - tests

    # Level 8 per docs/80-quality/coding-standards.md. Level 8 adds null-safety
    # analysis, which matters here: a nullable tenant id treated as non-null is
    # the shape of a cross-tenant bug.
    level: 8

    # No tmpDir override. PHPStan caches to the system temp directory, which is
    # outside the repository -- a project-local cache directory that Laravel's
    # .gitignore does not know about dumps hundreds of hash-named files into
    # source control.

    ignoreErrors:
        # Pest binds $this in a test closure to the configured TestCase at
        # runtime (see tests/Pest.php), but that binding is invisible to static
        # analysis, so every $this->getJson() in a feature test reads as a call
        # on Pest's TestCall.
        #
        # This is a tooling limitation, not a defect in the code, and the
        # alternative -- dropping tests/ from analysis -- would lose real
        # type-checking across the whole suite. Scoped as tightly as possible:
        # only undefined methods and properties on TestCall, only under tests/.
        -
            identifier: method.notFound
            message: '#Call to an undefined method Pest\\PendingCalls\\TestCall::#'
            path: tests
        # Add further ignores here, each with a comment explaining why.
        # Never a blanket suppression.
