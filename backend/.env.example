# Local development defaults that WORK on a clean machine.
#
# APP_URL is http://localhost deliberately, not a .test domain: tenancy is resolved
# from the host, and *.localhost resolves to 127.0.0.1 without editing /etc/hosts. So
# the seeded clinic is reachable at kira.localhost:8000 immediately.
#
# CACHE_STORE, SESSION_DRIVER and QUEUE_CONNECTION avoid the database and Redis on
# purpose. The cache and queue TABLES are created by migrations, so a database cache
# store cannot be used while migrating — that exact circularity broke CI once, where
# spatie's permission migration flushed a cache that had no table yet.
#
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=carevelo
DB_USERNAME=carevelo_app
DB_PASSWORD=app_secret

# The MIGRATOR connection. Two roles, and the split is the tenant-isolation control:
# PostgreSQL exempts a table's OWNER from row-level security, so the application role
# must never own a table. carevelo_migrator owns the schema and runs migrations;
# carevelo_app reads and writes it and holds NOBYPASSRLS.
#
# `php artisan db:roles` creates both. Migrations run with
# --database=pgsql_migrator, which is what `composer migrate` does.
#
# @see docs/30-architecture/multi-tenancy.md
DB_MIGRATOR_USERNAME=carevelo_migrator
DB_MIGRATOR_PASSWORD=migrator_secret

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Reverb, ON. It was `log` until now, which meant every broadcast the product
# raises went into storage/logs and no socket ever saw it — the events, channels
# and channel policies were complete and tested against a driver that delivers
# nothing.
#
# The app id, key and secret below are LOCAL DEVELOPMENT VALUES and are checked
# in on purpose so a clean clone has a working websocket without a setup step.
# They are not credentials: Reverb here listens on localhost only. Every deployed
# environment generates its own — `php artisan reverb:install` will, or any random
# string of reasonable length.
#
# REVERB_SERVER_* is where the server BINDS. REVERB_HOST/PORT/SCHEME is where
# clients — the browser, and this application publishing events to it — go to
# find it. They differ on purpose: 0.0.0.0 is not an address anyone dials.
#
# Start it alongside the API with `composer dev:realtime`. `composer dev` still
# serves the API on its own, and a missing Reverb degrades the clinic to polling
# rather than failing the action that produced the event — see TenantBroadcast,
# which implements ShouldRescue precisely so that stays true under the sync queue
# below.
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=carevelo-local
REVERB_APP_KEY=carevelo-local-key
REVERB_APP_SECRET=carevelo-local-secret

REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

FILESYSTEM_DISK=local
# sync runs a queued job INLINE, in the request that dispatched it. For queued
# broadcasts that means the HTTP POST to Reverb happens before the response is
# written, so a Reverb that is not running would fail the request — which is why
# TenantBroadcast is rescued. Run `composer dev:queue` with a real driver when
# you want to exercise the deferred path.
QUEUE_CONNECTION=sync

CACHE_STORE=array
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
